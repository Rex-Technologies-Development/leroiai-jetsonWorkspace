# Per-robot identity for the route-planner review test.
#
# Copy this to robot_config.env and edit. The real robot_config.env is
# gitignored on purpose -- each robot/laptop keeps its own, we never push it.
#
#   cp robot_config.env.example robot_config.env
#
# The route_planner_review.launch.py reads robot_config.env at launch time.
# You can also override either value inline, e.g.:
#   ALLIANCE=red ROBOT_SIZE=15 ros2 launch leroi_bringup route_planner_review.launch.py

# Which robot this is: 24 or 15 (inches).
#   24 -> plays the LEFT half of the field  (x in [0, 72])
#   15 -> plays the RIGHT half of the field (x in [72, 144])
ROBOT_SIZE=24

# Our alliance: blue or red.
ALLIANCE=blue
