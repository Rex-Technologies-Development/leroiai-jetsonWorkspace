<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>leroi_policy</name>
  <version>0.0.0</version>
  <description>RL policy deployment: runs an exported ONNX policy live, turning
  perception game-state into robot actions for the decision layer.</description>
  <maintainer email="leoxie080808@gmail.com">leroi-ultio</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>leroi_interfaces</depend>
  <depend>python3-numpy</depend>
  <!-- onnxruntime is not packaged for rosdep; install it via pip into the user
       site: run "pip install onnxruntime==1.17.0" with the user flag. 1.17.0
       works on Jetson/Tegra; newer PyPI wheels crash on this CPU. -->
  <exec_depend>python3-onnxruntime-pip</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
